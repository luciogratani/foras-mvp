# Copy this file to apps/web/.env.local and apps/admin/.env.local
# Fill in your credentials from: supabase.com → project → Settings → API

# Supabase project URL — found in Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key — found in Settings → API → Project API keys → anon / public
# Safe to expose in the browser; security is enforced by RLS policies, not by hiding this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL schema for this tenant — "template" during development, "bar_rossi" for a real client
NEXT_PUBLIC_SUPABASE_SCHEMA=template

# Supabase service_role key — Settings → API → Project API keys → service_role
# SERVER ONLY — non esporre, non NEXT_PUBLIC_, mai nel bundle client.
# Usata da apps/admin (verifica owner in public.tenants) e da apps/web (write-path bookings server-side).
SUPABASE_SERVICE_ROLE_KEY=

# Endpoint HTTP del container supabase-meta usato dallo script `pnpm --filter @repo/supabase gen:types`.
# Solo CLI/dev, non runtime, mai NEXT_PUBLIC_. Lasciare vuoto = default `http://localhost:18080`.
# Richiede tunnel SSH attivo verso il container supabase-meta sulla VPS:
#   ssh -N -L 18080:<IP_CONTAINER_META>:8080 foras-vps
# (recupera IP con: ssh foras-vps "docker inspect supabase-meta --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}'")
SUPABASE_META_URL=

# ── Stripe — abbonamento del gestionale (solo apps/admin) ──────────────────
# Finché queste due sono vuote, il gestionale funziona normalmente: la pagina
# Account dice «nessun abbonamento attivo» e nessuno viene mai bloccato.
# Procedura completa: docs/operations/stripe.md

# Chiave segreta — Dashboard Stripe → Sviluppatori → Chiavi API.
# `sk_test_…` in modalità test, `sk_live_…` in produzione. Il gestionale
# riconosce le chiavi di test e lo segnala a schermo.
# SERVER ONLY — mai NEXT_PUBLIC_, mai nel bundle client: questa chiave può fare
# qualunque cosa sull'account Stripe, rimborsi inclusi.
STRIPE_SECRET_KEY=

# Segreto di firma del webhook — Dashboard → Sviluppatori → Webhook → endpoint.
# In locale con `stripe listen` ne viene stampato uno DIVERSO, valido solo per
# quella sessione di ascolto.
# Senza questo, ogni evento viene rifiutato: è ciò che impedisce a chiunque
# conosca l'indirizzo di dichiarare pagato un abbonamento con un curl.
STRIPE_WEBHOOK_SECRET=

# Accende il pulsante flottante che simula i tre stati dell'abbonamento.
# In locale è già acceso da solo e questa variabile non serve.
#
# Serve SOLO nelle anteprime Vercel, dove NODE_ENV è già "production" ma il
# cliente non c'è — e funziona solo lì: su un deploy di produzione non ha alcun
# effetto, perché la finzione richiede VERCEL_ENV=preview. Metterla in Production
# è inutile, non pericoloso.
FORAS_BILLING_DEV=
